# GFMD Email Automation - Railway Deployment
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir torch==2.15.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create non-root user for security
RUN useradd -m -u 1000 railwayuser && chown -R railwayuser:railwayuser /app
USER railwayuser

# Set environment variables
ENV PYTHONPATH=/app
ENV TOKENIZERS_PARALLELISM=false
ENV PYTHONUNBUFFERED=1
ENV GFMD_AUTOMATION_ENABLED=0
ENV GFMD_EMAIL_SEND_ENABLED=0
ENV GFMD_SPECTRUM_SEND_ENABLED=0
ENV GFMD_SPECTRUM_ENROLLMENT_ENABLED=0
ENV GFMD_SPECTRUM_AUTO_REPLY_ENABLED=0

# Railway uses PORT environment variable
EXPOSE 8080

# Start health server (which spawns the scheduler as a subprocess)
CMD ["python3", "health_server.py"]
