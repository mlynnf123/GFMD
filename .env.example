# GFMD Narcon System Environment Variables
# Copy this file to .env and fill in your actual values

# MongoDB Atlas Connection
MONGODB_CONNECTION_STRING="mongodb+srv://<username>:<password>@<cluster>/"
MONGODB_PASSWORD="your_actual_password_here"

# AI/LLM APIs
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
OPENAI_API_KEY="your_openai_api_key_here"

# Gmail Integration (Optional)
GMAIL_CREDENTIALS_PATH="path/to/gmail_credentials.json"
GMAIL_TOKEN_PATH="path/to/gmail_token.json"

# Local safety defaults. Production activation is configured in Railway.
GFMD_AUTOMATION_ENABLED="0"
GFMD_EMAIL_SEND_ENABLED="0"
GFMD_SPECTRUM_SEND_ENABLED="0"
GFMD_SPECTRUM_ENROLLMENT_ENABLED="0"
GFMD_SPECTRUM_AUTO_REPLY_ENABLED="0"

# Environment Setting
ENVIRONMENT="development"  # or "production"

# Email Tracking Domain (Optional)
TRACKING_DOMAIN="your-domain.com"
